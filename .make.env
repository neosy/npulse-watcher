# App
APP_NAME=npulse-watcher

# Private docker hub
DOCKER_HUB=dh.n-hub.ru

# Docker address
DOCKER_HTTP_ADRR_TAG_LIST=https://${DOCKER_HUB}/v2/neosy/${APP_NAME}/tags/list

# Base image name
APP_IMG_NAME=neosy/npulse-watcher

# Image tags
APP_IMG_NAME_LATEST=${APP_IMG_NAME}:latest

# Images
APP_IMG=${DOCKER_HUB}/${APP_IMG_NAME}
APP_IMG_LATEST=${DOCKER_HUB}/${APP_IMG_NAME_LATEST}

# Stack name
STACK_NAME=npulse

# Services
APP_SERVICE=npulse_watcher

# Binding to a node
NODE_HOSTNAME=nvAlgalon

# Ports
HTTP_PORT=8014

# Volumes
NFS_DATA_SERVER=192.168.23.11

# Environments
WATCHER_TELEGRAM_CHAT_ID=475133928
REDIS_ADDRESSES=192.168.23.11:3101
REDIS_PREFIX_KEY=home:npulse-watcher
