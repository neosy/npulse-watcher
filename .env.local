# Log
LOG_FORMAT=console
LOG_LEVEL=debug

# port FastHTTP
HTTP_SERVER_PORT=8085

# Redis
REDIS_CONNECTION_TYPE="SIMPLE"
REDIS_PREFIX_KEY="home:npulse-watcher"
#SENTINEL_MASTER_NAME="mymaster"
REDIS_ADDRESSES=192.168.0.11:3101

# Application
WATCHER_NOTIFY_INTERVAL=60
WATCHER_TELEGRAM_TOKEN_FILE=./secrets/npulse_telegram_token
WATCHER_TELEGRAM_CHAT_ID=
WATCHER_LOG_FOLDERPATH=~/log/nPulseWatcher
